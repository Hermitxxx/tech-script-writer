        "options": {}
      },
      "id": "rss-2",
      "name": "Ars Technica Feed",
      "type": "n8n-nodes-base.rssFeedRead",
      "typeVersion": 1.1,
      "position": [
        640,
        380
      ]
    },
    {
      "parameters": {
        "mode": "append"
      },
      "id": "merge-1",
      "name": "Merge Feed Sources",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        840,
        300
      ]
    },
    {
      "parameters": {
        "operation": "removeItemsSeenInPreviousExecutions",
        "logic": "removeItemsWithAlreadySeenKeyValues",
        "dedupeValue": "={{ $json.link || $json.title }}",
        "options": {
          "scope": "workflow",
          "historySize": 5000
        }
      },
      "id": "dedupe-1",
      "name": "Filter Seen News",
      "type": "n8n-nodes-base.removeDuplicates",
      "typeVersion": 1.5,
      "position": [
        1040,
        300
      ]
    },
    {
      "parameters": {
        "maxItems": 4,
        "keep": "firstItems"
      },
      "id": "limit-1",
      "name": "Pick Top 4 Candidate Articles",
      "type": "n8n-nodes-base.limit",
      "typeVersion": 1,
      "position": [
        1240,
        300
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are Sub-Agent 1 (Tech Content Researcher).\nAnalyze the following incoming tech news story candidate:\n\n📰 Headline: {{ $json.title }}\n📝 Summary: {{ $json.contentSnippet || $json.content || '' }}\n🔗 Source: {{ $json.link }}\n\nSynthesize this into a structured research briefing for our Agency Central Supervisor:\n- Significance Score (1-10)\n- Core Technological Innovation\n- Why agency clients & tech community members care\n- 3 critical bullet facts",
        "options": {
          "systemMessage": "You are Sub-Agent 1: Senior Tech Content Researcher for an innovative digital agency. Your job is to extract high-value insights, weed out fluff, and present deep, verified technical briefings."
        }
      },
      "id": "subagent-1",
      "name": "Sub-Agent 1: Tech Researcher",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        1460,
        300
      ]
    },
    {
      "parameters": {
        "model": "openai/gpt-4o-mini",
        "options": {}
      },
      "id": "lm-researcher",
      "name": "OpenRouter Model (Researcher)",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenRouter",
      "typeVersion": 1,
      "position": [
        1460,
        500
      ],
      "credentials": {
        "openRouterApi": {
          "id": "m6u0ALgfgS4WXwGt",
          "name": "OpenRouter account"
        }
      }
    },
    {
      "parameters": {
        "aggregate": "aggregateAllItemData",
        "destinationFieldName": "researchedStories",
        "options": {}
      },
      "id": "aggregate-1",
      "name": "Aggregate Research",
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [
        1700,
        300
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are the Agency Central Supervisor & Editor-in-Chief.\nHere are the candidate research briefings from Sub-Agent 1:\n\n{{ JSON.stringify($json.researchedStories) }}\n\nYour tasks:\n1. Select the single MOST impactful, breakthrough story for our agency's WhatsApp group.\n2. Write a captivating, high-retention WhatsApp post using WhatsApp Markdown (*bold*, _italics_, clean emojis, dividers, and bullet points).\n3. Craft a specialized, hyper-detailed visual prompt for Sub-Agent 2 (Poster Designer) to generate a sleek AI tech poster.\n\nRespond ONLY with a valid JSON object in this exact schema (NO markdown formatting, NO backticks):\n{\n  \"selectedTitle\": \"Story headline\",\n  \"whatsappCaption\": \"*⚡ AGENCY TECH RADAR*\\n━━━━━━━━━━━━━━━━━━━\\n\\n*🚀 Headline*\\n\\n> 💡 *Quick Take:*\\n> Brief summary\\n\\n📌 *Key Highlights:*\\n• 🔹 Point 1\\n• 🔹 Point 2\\n• 🔹 Point 3\\n\\n💬 *Community Debate:*\\nEngaging question\\n\\n━━━━━━━━━━━━━━━━━━━\\n🌐 _Agency Intelligence Desk_\",\n  \"imagePrompt\": \"A futuristic isometric 3D concept render of [Topic], glowing neon cyan and purple accents, high-tech holographic circuitry, dark minimalist agency aesthetic, Octane render 8K resolution, cinematic lighting, sleek corporate tech vibe, no text\"\n}",
        "options": {
          "systemMessage": "You are the Agency Central Supervisor and Creative Director. You maintain brand excellence, direct sub-agents, and ensure all published content is engaging, authoritative, and visually stunning."
        }
      },
      "id": "central-agent",
      "name": "Central Agent: Agency Supervisor",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        1940,
        300
      ]
    },
    {
      "parameters": {
        "model": "anthropic/claude-3.5-sonnet",
        "options": {}
      },
      "id": "lm-supervisor",
      "name": "OpenRouter Model (Supervisor)",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenRouter",
      "typeVersion": 1,
      "position": [
        1940,
        500
      ],
      "credentials": {
        "openRouterApi": {
          "id": "m6u0ALgfgS4WXwGt",
          "name": "OpenRouter account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "let raw = $input.first().json.output;\ntry {\n  if (typeof raw === 'string') {\n    raw = raw.replace(/^```json\\s*/i, '').replace(/^```\\s*/i, '').replace(/\\s*```$/, '').trim();\n    raw = JSON.parse(raw);\n  }\n} catch (e) {\n  raw = {\n    whatsappCaption: $input.first().json.output,\n    imagePrompt: \"A sleek futuristic high tech digital agency 3D render, glowing neon circuits, dark minimalist aesthetic, 8k resolution, no text\"\n  };\n}\n\nconst config = $('Agency & WhatsApp Config').first().json;\n\nreturn [{\n  json: {\n    ...raw,\n    ...config\n  }\n}];"
      },
      "id": "code-parser",
      "name": "Parse Supervisor Directive",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2180,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://openrouter.ai/api/v1/images",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $json.openrouterApiKey }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"black-forest-labs/flux.1-schnell\",\n  \"prompt\": {{ JSON.stringify($json.imagePrompt) }}\n}",
        "options": {}
      },
      "id": "subagent-2-image",
      "name": "Sub-Agent 2: Generate AI Poster (OpenRouter FLUX)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2420,
        300
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "const prev = $('Parse Supervisor Directive').first().json;\nconst imgResponse = $input.first().json;\n\n// Extract image from OpenRouter (base64 or URL) with high-res Flux fallback\nlet imageMedia = '';\n\nif (imgResponse.data && imgResponse.data[0]) {\n  if (imgResponse.data[0].b64_json) {\n    imageMedia = 'data:image/png;base64,' + imgResponse.data[0].b64_json;\n  } else if (imgResponse.data[0].url) {\n    imageMedia = imgResponse.data[0].url;\n  }\n}\n\n// Fallback to high-res Flux render if OpenRouter key is empty during testing\nif (!imageMedia) {\n  const safePrompt = encodeURIComponent(prev.imagePrompt || 'Futuristic tech artificial intelligence quantum concept render');\n  imageMedia = 'https://image.pollinations.ai/prompt/' + safePrompt + '?width=1024&height=1024&model=flux&nologo=true';\n}\n\nreturn [{\n  json: {\n    evolutionApiUrl: prev.evolutionApiUrl,\n    evolutionInstance: prev.evolutionInstance,\n    evolutionApiKey: prev.evolutionApiKey,\n    whatsappGroupJid: prev.whatsappGroupJid,\n    caption: prev.whatsappCaption,\n    imageMedia: imageMedia,\n    selectedTitle: prev.selectedTitle\n  }\n}];"
      },
      "id": "code-prep-evolution",
      "name": "Prepare Evolution Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2660,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.evolutionApiUrl }}/message/sendMedia/{{ $json.evolutionInstance }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $json.evolutionApiKey }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"number\": \"{{ $json.whatsappGroupJid }}\",\n  \"mediatype\": \"image\",\n  \"mimetype\": \"image/png\",\n  \"caption\": {{ JSON.stringify($json.caption) }},\n  \"media\": \"{{ $json.imageMedia }}\",\n  \"fileName\": \"agency_tech_radar.png\"\n}",
        "options": {}
      },
      "id": "subagent-2-publish",
      "name": "Sub-Agent 2: Publish to WhatsApp Group",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2900,
        300
      ]
    }
  ],
